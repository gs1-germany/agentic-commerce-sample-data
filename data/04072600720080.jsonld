        "gs1:PackagingMarkedLabelAccreditationCode-CRUELTY_FREE_PETA"
    ],
    "gs1:ingredientStatement": {
        "de": "Ingredients: Aqua, Cetearyl Alcohol, Behentrimonium Chloride, Cetyl Esters, Dipropylene Glycol, Glycerin, Panthenol, Tetrasodium Glutamate Diacetate, Lactic Acid, Ethylhexylglycerin, Pyrus Communis Fruit Extract, Persea Gratissima Oil, Tocopherol, Phenoxyethanol, Parfum."
    },
    "gs1de:descriptionShort": {
        "de": "30_sek Intensiv Kur Reparatur 100ml"
    },
    "gs1:functionalName": {
        "de": "Kur"
    },
    "gs1:productDescription": {
        "de": "GUHL 30_sek Intensiv Kur Reparatur 100ml"
    },
    "gs1:variantDescription": {
        "de": "Reparatur"
    },
    "gs1:consumerUsageInstructions": {
        "de": "Anwendung: Nach der Haarwäsche ins nasse Haar einmassieren, 30 Sekunden einwirken lassen und ausspülen."
    },
