    "gs1:packagingMarkedLabelAccreditation": [
        "gs1:PackagingMarkedLabelAccreditationCode-CRUELTY_FREE_PETA",
        "gs1:PackagingMarkedLabelAccreditationCode-GREEN_DOT"
    ],
    "gs1:ingredientStatement": {
        "de": "INGREDIENTS: Aqua, Sodium Laureth Sulfate, Cocamidopropyl Betaine, Coco-Glucoside, Beer, Lactic Acid, Glyceryl Oleate, Sorbitan Caprylate, Hydroxypropyl Guar Hydroxypropyltrimonium Chloride, Sodium Chloride, Erythritol, Panthenol, Tetrasodium Glutamate Diacetate, Glycine, Piroctone Olamine, Citric Acid, Sodium Sulfate, Sodium Benzoate, Parfum, Citrus Limon Peel Oil, Limonene, Tetramethyl Acetyloctahydronaphthalenes, CI 15510, Caramel."
    },
    "gs1de:descriptionShort": {
        "de": "GUHL INTENSIV KRÄFTIGUNG Sham 500ML"
    },
    "gs1:functionalName": {
        "de": "Shampoo"
    },
    "gs1:productDescription": {
        "de": "GUHL SILBER INTENSIV KRÄFTIGUNG Shampoo 500 ml"
    },
    "gs1:consumerUsageInstructions": {
        "de": "ANWENDUNG: Guhl Shampoos sind besonders ergiebig*. Eine kleine Menge ist ausreichend. Sanft ins nasse Haar einmassieren und genießen. Gut ausspülen. * Eine kleine Menge genügt - dank reichhaltigem Schaum"
    },
